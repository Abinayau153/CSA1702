      "source": [
        "%%writefile family_search.c\n",
        "#include <stdio.h>\n",
        "#include <string.h>\n",
        "\n",
        "struct Person {\n",
        "    char name[20];\n",
        "    char father[20];\n",
        "    char mother[20];\n",
        "};\n",
        "\n",
        "int main() {\n",
        "    struct Person family[] = {\n",
        "        {\"David\", \"John\", \"Mary\"},\n",
        "        {\"Lisa\", \"John\", \"Mary\"},\n",
        "        {\"Peter\", \"David\", \"Anna\"}\n",
        "    };\n",
        "\n",
        "    char child[20];\n",
        "    int found = 0;\n",
        "\n",
        "    printf(\"Enter child's name: \");\n",
        "    scanf(\"%s\", child);\n",
        "\n",
        "    for (int i = 0; i < 3; i++) {\n",
        "        if (strcmp(child, family[i].name) == 0) {\n",
        "            printf(\"Father: %s\\n\", family[i].father);\n",
        "            printf(\"Mother: %s\\n\", family[i].mother);\n",
        "            found = 1;\n",
        "            break;\n",
        "        }\n",
        "    }\n",
        "\n",
        "    if (!found) {\n",
        "        printf(\"Person not found.\\n\");\n",
        "    }\n",
        "\n",
        "    return 0;\n",
        "}"
