      "source": [
        "# Dieting System Based on Disease\n",
        "\n",
        "diets = {\n",
        "    \"diabetes\": [\n",
        "        \"Vegetables\",\n",
        "        \"Whole grains\",\n",
        "        \"Nuts\",\n",
        "        \"Low-sugar fruits\"\n",
        "    ],\n",
        "\n",
        "    \"hypertension\": [\n",
        "        \"Fruits\",\n",
        "        \"Vegetables\",\n",
        "        \"Whole grains\",\n",
        "        \"Low-salt foods\"\n",
        "    ],\n",
        "\n",
        "    \"anemia\": [\n",
        "        \"Spinach\",\n",
        "        \"Beans\",\n",
        "        \"Iron-rich foods\",\n",
        "        \"Vitamin C rich fruits\"\n",
        "    ],\n",
        "\n",
        "    \"obesity\": [\n",
        "        \"Vegetables\",\n",
        "        \"Salads\",\n",
        "        \"Whole grains\",\n",
        "        \"Low-calorie foods\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "# Get disease from user\n",
        "disease = input(\"Enter the disease: \").lower()\n",
        "\n",
        "# Check disease and suggest diet\n",
        "if disease in diets:\n",
        "    print(\"\\nRecommended diet for\", disease, \":\")\n",
        "\n",
        "    for food in diets[disease]:\n",
        "        print(\"-\", food)\n",
        "\n",
        "else:\n",
        "    print(\"Disease not found in the system.\")"
      ],
