      "source": [
        "# Medical Diagnosis System\n",
        "\n",
        "print(\"Medical Diagnosis System\")\n",
        "print(\"------------------------\")\n",
        "\n",
        "fever = input(\"Do you have fever? (yes/no): \").lower()\n",
        "cough = input(\"Do you have cough? (yes/no): \").lower()\n",
        "headache = input(\"Do you have headache? (yes/no): \").lower()\n",
        "body_pain = input(\"Do you have body pain? (yes/no): \").lower()\n",
        "sore_throat = input(\"Do you have sore throat? (yes/no): \").lower()\n",
        "\n",
        "\n",
        "# Rules for diagnosis\n",
        "\n",
        "if fever == \"yes\" and cough == \"yes\" and body_pain == \"yes\":\n",
        "    print(\"\\nPossible diagnosis: Flu\")\n",
        "\n",
        "elif fever == \"yes\" and sore_throat == \"yes\" and cough == \"yes\":\n",
        "    print(\"\\nPossible diagnosis: Throat infection\")\n",
        "\n",
        "elif headache == \"yes\" and fever == \"yes\":\n",
        "    print(\"\\nPossible diagnosis: Fever-related illness\")\n",
        "\n",
        "elif cough == \"yes\" and sore_throat == \"yes\":\n",
        "    print(\"\\nPossible diagnosis: Common cold\")\n",
        "\n",
        "else:\n",
        "    print(\"\\nDiagnosis could not be determined.\")\n",
        "    print(\"Please consult a qualified medical professional.\")"
