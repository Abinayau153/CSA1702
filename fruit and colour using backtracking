      "cell_type": "code",
      "source": [
        "# Fruit and Color using Backtracking\n",
        "\n",
        "fruits = [\"apple\", \"banana\", \"orange\"]\n",
        "colors = [\"red\", \"yellow\", \"orange\"]\n",
        "\n",
        "solution = {}\n",
        "\n",
        "def backtrack(index):\n",
        "    # If all fruits are assigned a color\n",
        "    if index == len(fruits):\n",
        "        return True\n",
        "\n",
        "    fruit = fruits[index]\n",
        "\n",
        "    for color in colors:\n",
        "\n",
        "        # Check whether this color is already used\n",
        "        if color not in solution.values():\n",
        "\n",
        "            # Assign color\n",
        "            solution[fruit] = color\n",
        "\n",
        "            # Try the next fruit\n",
        "            if backtrack(index + 1):\n",
        "                return True\n",
        "\n",
        "            # If it doesn't work, undo the assignment\n",
        "            del solution[fruit]\n",
        "\n",
        "    return False\n",
        "\n",
        "\n",
        "# Start backtracking\n",
        "if backtrack(0):\n",
        "    print(\"Fruit and Color:\")\n",
        "    for fruit, color in solution.items():\n",
        "        print(fruit, \"->\", color)\n",
        "else:\n",
        "    print(\"No solution found.\")"
